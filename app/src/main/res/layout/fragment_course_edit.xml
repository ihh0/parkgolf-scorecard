<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:padding="@dimen/screen_padding">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <EditText android:id="@+id/etVenueName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min" android:hint="@string/venue_name_hint"
            android:textSize="@dimen/body_text" android:inputType="text" />
        <EditText android:id="@+id/etCourseName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min" android:hint="@string/course_name_hint"
            android:text="A코스" android:textSize="@dimen/body_text" android:inputType="text" />
        <EditText android:id="@+id/etHoleCount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min" android:hint="@string/hole_count_hint"
            android:text="9" android:textSize="@dimen/body_text" android:inputType="number" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPars"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" android:layout_marginTop="8dp" />
        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="88dp" android:text="@string/save"
            android:textSize="@dimen/title_text" android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
