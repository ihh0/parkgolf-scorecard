<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/parkBackground">
    <include android:id="@+id/topBar" layout="@layout/view_top_bar" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/screen_padding" android:layout_marginTop="12dp">
        <TextView android:id="@+id/tabRecent10"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:paddingVertical="10dp" android:layout_marginEnd="6dp"
            android:text="@string/stats_period_recent10" android:textSize="15sp" />
        <TextView android:id="@+id/tab3m"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:paddingVertical="10dp" android:layout_marginEnd="6dp"
            android:text="@string/stats_period_3m" android:textSize="15sp" />
        <TextView android:id="@+id/tabAll"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:paddingVertical="10dp"
            android:text="@string/stats_period_all" android:textSize="15sp" />
    </LinearLayout>

    <TextView android:id="@+id/btnCourseFilter"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding" android:layout_marginTop="10dp"
        android:background="@drawable/bg_card" android:paddingVertical="14dp" android:paddingHorizontal="16dp"
        android:text="@string/stats_course_all" android:textColor="?attr/parkForeground"
        android:textSize="15sp" android:drawableEnd="@android:drawable/arrow_down_float" />

    <LinearLayout android:id="@+id/summaryCard"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@drawable/bg_card"
        android:layout_marginHorizontal="@dimen/screen_padding" android:layout_marginTop="10dp"
        android:paddingVertical="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/stats_games_count" android:textColor="?attr/parkMutedForeground" android:textSize="13sp" />
            <TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/parkForeground" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/stats_rel_avg" android:textColor="?attr/parkMutedForeground" android:textSize="13sp" />
            <TextView android:id="@+id/tvAvg" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/parkForeground" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/stats_rel_best" android:textColor="?attr/parkMutedForeground" android:textSize="13sp" />
            <TextView android:id="@+id/tvBest" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/parkForeground" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/stats_rel_worst" android:textColor="?attr/parkMutedForeground" android:textSize="13sp" />
            <TextView android:id="@+id/tvWorst" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/parkForeground" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView android:id="@+id/chartScroll"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding" android:layout_marginTop="12dp"
        android:background="@drawable/bg_card" android:paddingVertical="8dp"
        android:scrollbars="none" android:fillViewport="true"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="@dimen/scroll_fade">
        <com.parkgolf.score.ui.stats.BarChartView android:id="@+id/chart"
            android:layout_width="wrap_content" android:layout_height="240dp" />
    </HorizontalScrollView>

    <LinearLayout android:id="@+id/emptyView"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center" android:visibility="gone"
        android:paddingHorizontal="@dimen/screen_padding">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/stats_empty_title" android:textColor="?attr/parkForeground"
            android:textSize="18sp" android:textStyle="bold" android:gravity="center" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/stats_empty_desc" android:textColor="?attr/parkMutedForeground"
            android:textSize="15sp" android:layout_marginTop="4dp" android:gravity="center" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
